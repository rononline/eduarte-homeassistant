# Alleen nodig wanneer je de bridge buiten Home Assistant draait.
# Als add-on komen deze waarden uit /data/options.json.

PORTAL_URL=
EDUARTE_EMAIL=
EDUARTE_PASSWORD=
# TOTP-secret uit de QR-code van de 2FA-setup (leeg laten zonder 2FA).
TOTP_SECRET=
# Vul dit alleen als je een sessiecookie handmatig wilt hergebruiken.
AUTH_COOKIE=
IS_MICROSOFT_LOGIN=true

# Poort en optioneel gedeeld geheim voor /calendar.ics en /state.json.
PORT=8099
API_TOKEN=
CALENDAR_NAME=Rooster
# Agenda-items met deze namen tellen als stage, niet als les (komma-gescheiden).
PLACEMENT_NAMES=BPV

# Minuten tussen ophaalacties, en tussen pogingen na een fout.
REFRESH_INTERVAL=30
RETRY_INTERVAL=5
# Hoeveel dagen aan lessen uit het verleden bewaard blijven.
HISTORY_DAYS=90
# Hoeveel weken vooruit het rooster wordt opgehaald.
WEEKS_AHEAD=4

DATA_DIR=./data
HEADLESS=true
DISABLE_SANDBOX=false
SAVE_DATA=true
DEBUG=false
